{
  "name": "umo-tv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:protocol": "node scripts/test-backend.mjs",
    "test:filters": "esbuild scripts/test-filters.mjs --bundle --platform=node --outfile=scripts/test-filters.bundle.mjs && node scripts/test-filters.bundle.mjs",
    "test:chat": "node scripts/test-chat.mjs",
    "test": "npm run test:protocol && npm run test:filters && npm run test:chat",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@types/three": "^0.187.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250523.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.161.0"
  }
}
